{
  "name": "charlie-security-agent-e2e",
  "version": "1.0.0",
  "description": "End-to-End Playwright Automation Suite for Charlie StoreOS Security Agent",
  "scripts": {
    "test": "playwright test",
    "test:mock": "playwright test --project=mock",
    "test:live": "playwright test --project=live",
    "test:live:mutating": "playwright test --project=live-mutating",
    "mock:start": "npx tsx mock-server/server.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
